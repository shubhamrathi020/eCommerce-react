{
  "name": "ecommerce-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "React implementation of the shop's storefront, admin console and seller portal.",
  "scripts": {
    "start:storefront": "pnpm --filter @shop/storefront dev",
    "start:admin": "pnpm --filter @shop/admin dev",
    "start:seller": "pnpm --filter @shop/seller dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^27.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "@ecom/contracts": "github:shubhamrathi020/eCommerce-contracts#v0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "rxjs": "~7.8.0"
  },
  "packageManager": "pnpm@9.15.9"
}
