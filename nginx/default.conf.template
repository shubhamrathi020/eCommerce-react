server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  # Content-hashed build files never change: cache them for a year.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # The service worker and the shell must always be re-checked, or a new release would never reach returning visitors.
  location = /sw.js {
    add_header Cache-Control "no-cache";
    add_header Service-Worker-Allowed "/";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # The @PAY_*@ markers in the Content-Security-Policy below are filled in when the image is built (see the Dockerfile): the
  # storefront, which takes payments, lets Razorpay's checkout script, frame, API and images in; the other apps get nothing extra.
  # Single-page app: unknown paths fall back to index.html. Security headers are repeated here because nginx does not inherit
  # add_header into a block that defines its own.
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'@PAY_SCRIPT@; style-src 'self' 'unsafe-inline'; img-src 'self' data: ${API_ORIGIN}@PAY_IMG@; font-src 'self'; connect-src 'self' ${API_ORIGIN}@PAY_CONNECT@; frame-src 'self'@PAY_FRAME@; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    try_files $uri $uri/ /index.html;
  }
}
